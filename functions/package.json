{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "dev:emul": "dotenv -e .env.local -- dotenv -e prisma/.env -- firebase emulators:start --only functions",
    "prisma:gen": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e prisma/.env -- prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "NODE_OPTIONS=--dns-result-order=ipv4first dotenv -e prisma/.env -- prisma db push --schema=prisma/schema.prisma",
    "prisma:setup": "npm run prisma:gen && npm run prisma:push"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.11",
    "@types/supertest": "^2.0.16",
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.18.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
