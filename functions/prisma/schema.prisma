// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// Plantilla/catálogo de evaluaciones (definiciones, no instancias realizadas)
model Evaluacion {
  id     String @id @default(uuid())
  titulo String
}

enum Rol {
  docente
  director
  encargado_zona
  equipo_padi
}

model UsuarioPerfil {
  id        String   @id @db.Uuid
  email     String   @unique
  nombre    String
  apellido  String
  rol       Rol
  createdAt DateTime @default(now())

  @@map("usuarios") // mapea a la tabla public.usuarios de Supabase
}

// Instancia de evaluación realizada por un estudiante (quién/cuándo/estado/puntaje)
model EvaluacionEstudiante {
  id           String   @id @default(uuid()) @db.Uuid
  estudianteId String   @db.Uuid
  salaId       Int      @db.SmallInt
  tipoId       String
  estadoId     String
  puntaje      Float?
  createdAt    DateTime @default(now())

  @@map("evaluaciones_estudiante")
}